root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.cs]
# Fails the solution when a class uses a non-primary constructor.
dotnet_diagnostic.IDE0290.severity = error

# Fails the solution when the API layer is implemented with controllers instead of handlers.
# This complements the project-level validation target that rejects ControllerBase or MapControllers.

# Keep the project style explicit and consistent.
csharp_prefer_primary_constructors = true:error

# Avoid XML-doc noise for this sample project.
dotnet_diagnostic.CS1591.severity = none
