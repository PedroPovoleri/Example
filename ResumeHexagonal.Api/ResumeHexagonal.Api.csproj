<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest</AnalysisLevel>

    <ContainerImageName>resumehexagonal-api</ContainerImageName>
    <ContainerImageTag>latest</ContainerImageTag>
    <ContainerBaseImage>mcr.microsoft.com/dotnet/aspnet:10.0</ContainerBaseImage>
    <ContainerPort>8080</ContainerPort>
    <ContainerRuntimeIdentifier>linux-x64</ContainerRuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Build.Containers" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ResumeHexagonal.Application\ResumeHexagonal.Application.csproj" />
    <ProjectReference Include="..\ResumeHexagonal.Infrastructure\ResumeHexagonal.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="ValidateMinimalApiConvention" BeforeTargets="Build">
    <Exec Command="bash -c &quot;files=$(find '$(MSBuildProjectDirectory)' -name '*.cs' -type f); violations=(); for file in $files; do if grep -qE 'ControllerBase|MapControllers\s*\(' &quot;$file&quot;; then violations+=(&quot;$file&quot;); fi; done; if [ ${#violations[@]} -gt 0 ]; then echo 'Minimal API convention violation: use handlers and MapGroup/MapPost/MapGet instead of ControllerBase or MapControllers. Offending files:'; printf '%s\n' &quot;${violations[@]}&quot;; exit 1; fi&quot;" />
  </Target>

</Project>
